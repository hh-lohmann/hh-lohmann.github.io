<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name=generator content="Jekyll + Human know-how">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    {%  if page.url == '/404.html' %}
      <link rel="stylesheet" href="/css/404.css">
      <title>Page not found</title>
    {% else %}
      <title>{{ site.title }}</title>
    {% endif %}
  </head>
  <body>
    <div class="page_start page_start_end_marker"></div>
    {% if page.url != '/' %}
      <nav>
        <a class="home" href="/">Frontend hh.lohmann</a>
      </nav>
      <h1>{{ page.title }}</h1>
    {% endif %}
    <h2>x{{ site.last_change }}</h2>
    <h2>x{{ site.package }}</h2>
    <h2>x{{ page.name }}</h2>
    <h2>x{{ page.url }}</h2>
    {% assign last = value %}
    {% if LAST_CHANGE %}
      <h2>Version: {% include_relative LAST_CHANGE %}</h2>
    {% endif %}
    <section>
      {{ content }}
    </section>
    <div class="page_end page_start_end_marker">
      <a class="top" href="#">[ zum Seitenanfang ]</a>
    </div>
    <script>
      document.querySelectorAll( 'a' ).forEach(
        ( hit, index ) => {
          if( hit.className.includes('home') ) return ;
          if( hit.className.includes('top') ) return ;
          if( ! hit.href.includes( document.location.host ) ) hit.title = 'externer Link' ;
          if( hit.href.includes( document.location.host ) ) hit.title = 'interner Link' ;
        }
      )
    </script>
  </body>
  <script>
    alert( 'Heyho!' ) ;
  </script>
</html>
